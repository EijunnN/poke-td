# Lo crea deploy/install.sh en /etc/poke-td.env (se puede editar después). Ver docs/DEPLOY.md.

PORT=8080
DB_PATH=/opt/poke-td/data/poke-td.sqlite
# Detrás de Caddy: la IP real del jugador viene en X-Forwarded-For.
TRUST_PROXY=1
# Cuentas con acceso a la moderación del ranking (nombres, separados por comas).
ADMIN_USERS=
# Copias de seguridad que se guardan (las más viejas se borran).
BACKUP_KEEP=14
