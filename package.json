{
  "name": "poke-td",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "bun --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "start": "bun server/index.ts",
    "test": "bun test tests/ && node tests/adversarial.ts",
    "test:record": "node tests/adversarial.ts --record",
    "test:e2e": "node tests/sync.e2e.ts && node tests/ranking.e2e.ts && node tests/coop.e2e.ts",
    "test:all": "bun run test && bun run test:e2e"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "playwright-core": "^1.48.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
